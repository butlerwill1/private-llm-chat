CHAT_ENVIRONMENT=development
CHAT_MODEL_BACKEND=openrouter
CHAT_STORAGE_BACKEND=local
# Leave the route mapping at the reviewed defaults unless you deliberately review a replacement.
CHAT_OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY
# The normal Windows key mode stores the transcript master key protected by your Windows account.
CHAT_LOCAL_KEY_MODE=dpapi
CHAT_OPENROUTER_ZDR_PREFLIGHT=true
CHAT_OPENROUTER_MAX_OUTPUT_TOKENS=4096
CHAT_ALLOW_CUSTOM_OPENROUTER_MODEL=false
# Override the default ignored local file used for private system instructions.
# CHAT_INSTRUCTIONS_FILE=.local/conversation-instructions.md

# This file is ignored by Git but stores the OpenRouter API key as plaintext. Do not share,
# commit, screenshot or back it up to an untrusted location. Rotate the key if exposed.

# Optional advanced self-hosted mode.
# CHAT_MODEL_BACKEND=self_hosted
# CHAT_MODEL_NAME=private-chat
# CHAT_SELF_HOSTED_BASE_URL=http://127.0.0.1:11434/v1

# Enable the laptop-local Ollama model alongside the reviewed OpenRouter catalogue.
# Run ..\scripts\setup-local-ollama.ps1 first. Ollama stays bound to loopback.
# CHAT_ENABLE_LOCAL_OLLAMA=true
# CHAT_LOCAL_OLLAMA_MODEL_NAME=gemma3:4b
# CHAT_TELEMETRY_ENABLED=true
# CHAT_TELEMETRY_SAMPLE_SECONDS=5
# Optional Libre Hardware Monitor web server, bound to loopback.
# CHAT_CPU_SENSOR_URL=http://127.0.0.1:8085/data.json

# Explicit portable/test local key mode. Never use this for normal Windows operation.
# CHAT_LOCAL_KEY_MODE=environment
# CHAT_LOCAL_MASTER_KEY_B64=REPLACE_WITH_32_RANDOM_BYTES_ENCODED_AS_BASE64

# To retain encrypted transcripts in AWS, replace memory storage with these
# values from Terraform. Your local AWS identity must have the application data policy.
# CHAT_STORAGE_BACKEND=s3
# CHAT_CONVERSATION_BUCKET=private-llm-chat-dev-conversation-example
# CHAT_KMS_KEY_ID=arn:aws:kms:eu-west-2:123456789012:key/example
# CHAT_AWS_REGION=eu-west-2
