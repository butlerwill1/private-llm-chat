aws_region   = "eu-west-2"
project_name = "private-llm-chat"
environment  = "dev"

# GPU resources are deliberately opt-in. Use a hardened pre-baked AMI because
# the isolated subnet has no general internet egress.
enable_gpu       = false
gpu_ami_id       = null
gpu_instance_type = "g6.xlarge"

tags = {
  Owner      = "platform-team"
  CostCentre = "personal"
}

