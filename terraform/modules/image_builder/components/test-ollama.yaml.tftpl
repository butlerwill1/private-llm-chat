name: TestOllama
description: Test the baked NVIDIA stack, Ollama service, model, and GPU inference.
schemaVersion: 1.0
phases:
  - name: test
    steps:
      - name: TestNvidiaRuntime
        # Fail the AMI build unless EC2 exposes at least one usable NVIDIA GPU.
        # The second command records hardware and driver provenance in build logs.
        action: ExecuteBash
        # Image Builder aborts this step if its commands exceed two minutes.
        timeoutSeconds: 120
        # A failed prerequisite must reject the AMI rather than continue testing.
        onFailure: Abort
        inputs:
          commands:
            # Command substitution counts lines beginning "GPU "; test -ge 1
            # exits non-zero when the driver exposes no GPU to the operating system.
            - test "$(nvidia-smi --list-gpus | grep --count '^GPU ')" -ge 1
            # Print useful diagnostic values into the Image Builder execution log.
            - nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
            # Exercise the same bundled CUDA backend that Ollama will use. This
            # catches a driver/library mismatch before paying for a model load.
            - timeout 60s env HOME=/root LD_LIBRARY_PATH=/usr/lib/ollama:/usr/lib/ollama/cuda_v12 GGML_BACKEND_PATH=/usr/lib/ollama/cuda_v12/libggml-cuda.so /usr/lib/ollama/llama-server --list-devices | tee /tmp/ollama-cuda-devices
            - grep --extended-regexp --quiet '^[[:space:]]+CUDA[0-9]+:' /tmp/ollama-cuda-devices
      - name: TestOllamaService
        # Confirm systemd will start Ollama after future boots, then allow up to
        # eight minutes for the bounded CUDA readiness probe and loopback health
        # endpoint. Normal boots complete much sooner.
        action: ExecuteBash
        timeoutSeconds: 600
        onFailure: Abort
        inputs:
          commands:
            - |
              # -e stops on errors, -u rejects unset variables, and pipefail makes
              # any failed command in a pipeline fail the whole script block.
              set -euo pipefail
              # Image Builder's command runner may omit HOME. Ollama reads it
              # during CLI initialisation even when the CLI only calls its API.
              export HOME=/root
              # Verify the unit is configured to start automatically on EC2 boot.
              systemctl is-enabled --quiet ollama.service
              # Poll once every two seconds while the pre-start CUDA probe and
              # Ollama initialise. A successful curl breaks the loop early.
              for attempt in $(seq 1 240); do
                if curl --fail --silent http://127.0.0.1:11434/api/tags >/dev/null; then break; fi
                sleep 2
              done
              # Confirm the process is running now, independently of being enabled.
              systemctl is-active --quiet ollama.service
              # Exact version matching prevents an unreviewed Ollama upgrade from
              # being distributed merely because some executable is installed.
              /usr/bin/ollama --version | grep --fixed-strings '${ollama_version}'
              # The CUDA override is intentional: it bypasses an observed
              # automatic-discovery timeout while retaining real GPU validation
              # in the end-to-end inference test below.
              systemctl show ollama.service --property Environment --value \
                | grep --fixed-strings --quiet 'OLLAMA_LLM_LIBRARY=cuda_v12'
              # Fail before the expensive cold model read if Ollama somehow
              # selected CPU despite the readiness gate.
              if ! journalctl --unit ollama.service --no-pager \
                | grep --extended-regexp --quiet 'inference compute.*library=CUDA'; then
                echo 'Ollama did not select CUDA during service startup.' >&2
                systemctl status ollama.service --no-pager >&2 || true
                journalctl --unit ollama.service --no-pager --lines 250 >&2 || true
                nvidia-smi >&2 || true
                exit 1
              fi
              # Make one final required health call; --fail turns HTTP 4xx/5xx into
              # a non-zero exit and /dev/null discards the response body.
              curl --fail --silent http://127.0.0.1:11434/api/tags >/dev/null
      - name: TestGpuInference
        # Service-only images legitimately omit a model. When a verified model is
        # configured, however, the build must prove an end-to-end GPU generation.
        action: ExecuteBash
        timeoutSeconds: 2700
        onFailure: Abort
        inputs:
          commands:
            - |
              set -euo pipefail
              # Give the Ollama client a deterministic home in AWSTOE's otherwise
              # minimal command environment.
              export HOME=/root
              # Terraform renders model_enabled into this template. Exit success
              # when the AMI deliberately contains only Ollama and no baked model.
              if [ '${model_enabled}' != 'true' ]; then
                echo 'No model configured; NVIDIA and service tests passed, inference test skipped.'
                exit 0
              fi
              # `ollama show` fails if the configured imported model is absent.
              /usr/bin/ollama show '${model_name}' >/dev/null
              # This probe covers manifest availability, text generation,
              # vision generation, repeated warm vision requests, scheduler
              # registration in /api/ps, and observed non-zero GPU utilisation.
              # It prints and retains service, journal, GPU, process, memory,
              # storage, and OOM diagnostics if any bounded call fails.
              /usr/local/libexec/private-llm-chat/verify-ollama-readiness \
                '${model_name}' 3
