name: TestOllama
description: Test the baked NVIDIA stack, Ollama service, model, and GPU inference.
schemaVersion: 1.0
phases:
  - name: test
    steps:
      - name: TestNvidiaRuntime
        # Fail the AMI build unless EC2 exposes at least one usable NVIDIA GPU.
        # The second command records hardware and driver provenance in build logs.
        action: ExecuteBash
        # Image Builder aborts this step if its commands exceed two minutes.
        timeoutSeconds: 120
        # A failed prerequisite must reject the AMI rather than continue testing.
        onFailure: Abort
        inputs:
          commands:
            # Command substitution counts lines beginning "GPU "; test -ge 1
            # exits non-zero when the driver exposes no GPU to the operating system.
            - test "$(nvidia-smi --list-gpus | grep --count '^GPU ')" -ge 1
            # Print useful diagnostic values into the Image Builder execution log.
            - nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
      - name: TestOllamaService
        # Confirm systemd will start Ollama after future boots, then allow up to
        # two minutes for its loopback health endpoint to become available.
        action: ExecuteBash
        timeoutSeconds: 300
        onFailure: Abort
        inputs:
          commands:
            - |
              # -e stops on errors, -u rejects unset variables, and pipefail makes
              # any failed command in a pipeline fail the whole script block.
              set -euo pipefail
              # Verify the unit is configured to start automatically on EC2 boot.
              systemctl is-enabled --quiet ollama.service
              # Poll once every two seconds while Ollama initialises. A successful
              # curl breaks the loop early; otherwise execution continues after 60 tries.
              for attempt in $(seq 1 60); do
                if curl --fail --silent http://127.0.0.1:11434/api/tags >/dev/null; then break; fi
                sleep 2
              done
              # Confirm the process is running now, independently of being enabled.
              systemctl is-active --quiet ollama.service
              # Exact version matching prevents an unreviewed Ollama upgrade from
              # being distributed merely because some executable is installed.
              /usr/local/bin/ollama --version | grep --fixed-strings '${ollama_version}'
              # Make one final required health call; --fail turns HTTP 4xx/5xx into
              # a non-zero exit and /dev/null discards the response body.
              curl --fail --silent http://127.0.0.1:11434/api/tags >/dev/null
      - name: TestGpuInference
        # Service-only images legitimately omit a model. When a verified model is
        # configured, however, the build must prove an end-to-end GPU generation.
        action: ExecuteBash
        timeoutSeconds: 1800
        onFailure: Abort
        inputs:
          commands:
            - |
              set -euo pipefail
              # Terraform renders model_enabled into this template. Exit success
              # when the AMI deliberately contains only Ollama and no baked model.
              if [ '${model_enabled}' != 'true' ]; then
                echo 'No model configured; NVIDIA and service tests passed, inference test skipped.'
                exit 0
              fi
              # `ollama show` fails if the configured imported model is absent.
              /usr/local/bin/ollama show '${model_name}' >/dev/null
              # Use the loopback API used by the runtime adapter and allow enough
              # time for a large model's first load without permitting a hung build.
              # Capture the complete non-streaming JSON response in a shell variable.
              response=$(curl --fail --silent --show-error --max-time 1200 \
                http://127.0.0.1:11434/api/generate \
                --header 'Content-Type: application/json' \
                --data-binary '{"model":"${model_name}","prompt":"Reply with the word ready.","stream":false}')
              # printf avoids shell-specific echo escaping. grep exits non-zero unless
              # the JSON contains Ollama's completed-generation marker.
              printf '%s' "$response" | grep --extended-regexp --quiet '"done"[[:space:]]*:[[:space:]]*true'
              # Ollama's process report must attribute a non-zero percentage to
              # the GPU; CPU-only success would defeat the purpose of this AMI.
              # Print the process table once for build diagnostics, then pipe a
              # second copy to grep so CPU-only inference fails the build.
              /usr/local/bin/ollama ps
              /usr/local/bin/ollama ps | grep --extended-regexp --quiet '[1-9][0-9]*% GPU|100% GPU'
